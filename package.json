{
  "name": "atlaix-platform",
  "private": true,
  "version": "0.0.0",
  "description": "AI-powered crypto intelligence platform for token detection, market activity scoring, wallet intelligence, and risk analysis.",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n FORENSICS,APP -c cyan,green \"npm:dev:forensics\" \"npm:dev:web\"",
    "dev:web": "vite",
    "dev:forensics": "tsx server/forensics-server.ts",
    "start:backend": "tsx server/forensics-server.ts",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "video:studio": "remotion studio src/video/index.ts",
    "video:still": "remotion still src/video/index.ts AtlaixInvestorFilm out/atlaix-investor-film-frame.png --frame=450",
    "video:render": "remotion render src/video/index.ts AtlaixInvestorFilm out/atlaix-investor-film.mp4 --codec=h264 --crf=14"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.90.1",
    "@types/d3-force": "^3.0.10",
    "apexcharts": "^3.54.1",
    "d3-force": "^3.0.0",
    "geist": "^1.7.1",
    "lucide-react": "^0.562.0",
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "react-router-dom": "^7.11.0",
    "tsx": "^4.20.5"
  },
  "devDependencies": {
    "@remotion/cli": "^4.0.461",
    "@remotion/media": "^4.0.461",
    "@remotion/media-utils": "^4.0.461",
    "@remotion/shapes": "^4.0.461",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^22.14.0",
    "@vitejs/plugin-react": "^5.0.0",
    "autoprefixer": "^10.4.20",
    "concurrently": "^9.2.0",
    "jsdom": "^29.0.2",
    "postcss": "^8.4.49",
    "remotion": "^4.0.461",
    "tailwindcss": "^3.4.17",
    "ts-node": "^10.9.2",
    "typescript": "~5.8.2",
    "vite": "^6.2.0",
    "vitest": "^4.1.4"
  }
}
