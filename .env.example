# Local environment template for Atlaix development.
# Copy this file to `.env` and fill in the provider keys required for local development.

# Server-side provider keys
MORALIS_API_KEY=
ALCHEMY_API_KEY=
HELIUS_API_KEY=
GOPLUS_KEY=
GOPLUS_SECRET=

# Browser-exposed Supabase configuration
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Optional backend gateway override for deployed or local API routes
VITE_API_BASE_URL=

# Optional Railway/backend Detection Engine controls
DETECTION_ENGINE_ENABLED=false
DETECTION_ENGINE_INTERVAL_MS=300000
DETECTION_ENGINE_TOP_LIMIT=50
DETECTION_ENGINE_INITIAL_DELAY_MS=15000
DETECTION_ENGINE_PREWARM_LIMIT=50
DETECTION_ENGINE_CONFIGURE_WEBHOOKS=false

# Optional backend Smart Alerts evaluator controls
SMART_ALERTS_ENABLED=true
SMART_ALERTS_INTERVAL_MS=60000
SMART_ALERTS_INITIAL_DELAY_MS=10000
SMART_ALERTS_BATCH_SIZE=100
OPENROUTER_MODEL=openai/gpt-5.4-nano
